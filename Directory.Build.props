<Project>

  <!-- 所有 Moon.* / MoonWpfToolkit 專案共用的打包設定 -->
  <PropertyGroup>
    <Authors>moon851005</Authors>
    <Company>Moon</Company>
    <RepositoryUrl>https://github.com/moon851005/MoonWpfToolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/moon851005/MoonWpfToolkit</PackageProjectUrl>
    <!-- 不開源：不設 PackageLicenseExpression / PackageLicenseFile -->

    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- 版本號由 version.json + git height 推算 -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>

</Project>
