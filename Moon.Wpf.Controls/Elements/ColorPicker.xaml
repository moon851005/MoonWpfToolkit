<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:el="clr-namespace:Moon.Wpf.Controls.Elements">

    <!-- ===== 共用子樣板 ===== -->

    <!-- Slider 透明 RepeatButton（點擊軌道定位用） -->
    <ControlTemplate x:Key="ColorPicker.SliderButtonTemplate" TargetType="{x:Type RepeatButton}">
        <Rectangle Fill="Transparent"/>
    </ControlTemplate>

    <!-- Slider Thumb（白色實心，強對比邊框） -->
    <ControlTemplate x:Key="ColorPicker.SliderThumbTemplate" TargetType="{x:Type Thumb}">
        <Border Width="8" Height="20"
                CornerRadius="4"
                Background="White"
                BorderBrush="#CC333333"
                BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" Opacity="0.5" ShadowDepth="1" Direction="270"/>
            </Border.Effect>
        </Border>
    </ControlTemplate>

    <!-- 色相 Slider ControlTemplate（固定彩虹軌道） -->
    <ControlTemplate x:Key="ColorPicker.HueSliderTemplate" TargetType="{x:Type Slider}">
        <Grid>
            <Border CornerRadius="8" Height="16" ClipToBounds="True" Margin="5,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0.000"/>
                        <GradientStop Color="#FFFF00" Offset="0.167"/>
                        <GradientStop Color="#00FF00" Offset="0.333"/>
                        <GradientStop Color="#00FFFF" Offset="0.500"/>
                        <GradientStop Color="#0000FF" Offset="0.667"/>
                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                        <GradientStop Color="#FF0000" Offset="1.000"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                  Template="{StaticResource ColorPicker.SliderButtonTemplate}"
                                  Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                  Template="{StaticResource ColorPicker.SliderButtonTemplate}"
                                  Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ColorPicker.SliderThumbTemplate}"
                           Cursor="Hand"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- Alpha Slider ControlTemplate（透明軌道，漸層由外層 Rectangle 提供） -->
    <ControlTemplate x:Key="ColorPicker.AlphaSliderTemplate" TargetType="{x:Type Slider}">
        <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                              Template="{StaticResource ColorPicker.SliderButtonTemplate}"
                              Focusable="False"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                              Template="{StaticResource ColorPicker.SliderButtonTemplate}"
                              Focusable="False"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
                <Thumb Template="{StaticResource ColorPicker.SliderThumbTemplate}"
                       Cursor="Hand"/>
            </Track.Thumb>
        </Track>
    </ControlTemplate>

    <!-- 通道 Slider ControlTemplate（帶灰色軌道的通用水平拉桿） -->
    <ControlTemplate x:Key="ColorPicker.ChannelSliderTemplate" TargetType="{x:Type Slider}">
        <Grid>
            <Border CornerRadius="4" Height="4" Margin="5,0"
                    Background="{DynamicResource TextControlBorderBrush}"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                  Template="{StaticResource ColorPicker.SliderButtonTemplate}"
                                  Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                  Template="{StaticResource ColorPicker.SliderButtonTemplate}"
                                  Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Template="{StaticResource ColorPicker.SliderThumbTemplate}"
                           Cursor="Hand"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- ToggleButton ControlTemplate（文字輸入框風格外觀） -->
    <ControlTemplate x:Key="ColorPicker.ToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
        <Border x:Name="Root"
                CornerRadius="4"
                Background="{DynamicResource TextControlBackground}"
                BorderBrush="{DynamicResource TextControlBorderBrush}"
                BorderThickness="1"
                Padding="8,6">
            <ContentPresenter HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource TextControlBackgroundPointerOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource TextControlBackgroundPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===== ColorPicker 主樣式 ===== -->
    <Style x:Key="DefaultColorPickerStyle" TargetType="{x:Type el:ColorPicker}">
        <Setter Property="OverridesDefaultStyle"      Value="True"/>
        <Setter Property="SnapsToDevicePixels"         Value="True"/>
        <Setter Property="FocusVisualStyle"           Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type el:ColorPicker}">
                    <Grid>

                        <!-- 按鈕區（收合狀態）：色塊 + HEX 文字 + 展開箭頭 -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      OverridesDefaultStyle="True"
                                      Template="{StaticResource ColorPicker.ToggleButtonTemplate}"
                                      HorizontalAlignment="Left"
                                      MinWidth="160">
                            <DockPanel LastChildFill="True">
                                <!-- 顏色色塊 -->
                                <Border DockPanel.Dock="Left"
                                        Width="16" Height="16"
                                        CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,6,0"
                                        ClipToBounds="True">
                                    <Rectangle x:Name="PART_SwatchRect"/>
                                </Border>
                                <!-- 展開箭頭 -->
                                <TextBlock DockPanel.Dock="Right"
                                           FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextControlForeground}"
                                           Text="{DynamicResource ExpanderChevronDownGlyph}"/>
                                <!-- HEX 顯示文字 -->
                                <TextBlock x:Name="PART_HexDisplay"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextControlForeground}"
                                           Text="#FF0000"/>
                            </DockPanel>
                        </ToggleButton>

                        <!-- 選色面板 Popup -->
                        <Popup x:Name="PART_Popup"
                               PlacementTarget="{Binding ElementName=PART_ToggleButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=PART_ToggleButton, Mode=TwoWay}">
                            <Border CornerRadius="8"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush }"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Padding="12"
                                    Width="280"
                                    Margin="0,2,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="4" Direction="270"/>
                                </Border.Effect>

                                <StackPanel>

                                    <!-- SV 選色板（飽和度 × 亮度 2D 面板） -->
                                    <Border x:Name="PART_SvPanel"
                                            Height="200"
                                            CornerRadius="4"
                                            ClipToBounds="True"
                                            Cursor="Cross">
                                        <Grid>
                                            <!-- 白→色相 水平漸層（Fill 由 C# 動態建立） -->
                                            <Rectangle x:Name="PART_HueGradientRect"/>
                                            <!-- 透明→黑 垂直漸層（固定） -->
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="Transparent" Offset="0"/>
                                                        <GradientStop Color="Black"       Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <!-- 拖曳指示圓點 -->
                                            <Ellipse x:Name="PART_SvThumb"
                                                     Width="14" Height="14"
                                                     IsHitTestVisible="False"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Top"
                                                     Stroke="White"
                                                     StrokeThickness="2"
                                                     Fill="Transparent">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" Opacity="0.6" ShadowDepth="1" Direction="315"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <!-- 色相滑桿 -->
                                    <Slider x:Name="PART_HueSlider" IsMoveToPointEnabled="True"
                                            Margin="0,8,0,0"
                                            Minimum="0" Maximum="360"
                                            OverridesDefaultStyle="True"
                                            Template="{StaticResource ColorPicker.HueSliderTemplate}"/>

                                    <!-- Alpha 滑桿（可選顯示，Visibility 由 code-behind 控制） -->
                                    <Grid x:Name="PART_AlphaRow"
                                          Margin="0,8,0,0"
                                          Visibility="Collapsed">
                                        <!-- 棋盤格 + 動態漸層背景 -->
                                        <Border CornerRadius="8" Height="20" ClipToBounds="True" Margin="5,0">
                                            <Grid>
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <DrawingBrush TileMode="Tile"
                                                                      Viewport="0,0,8,8"
                                                                      ViewportUnits="Absolute">
                                                            <DrawingBrush.Drawing>
                                                                <DrawingGroup>
                                                                    <GeometryDrawing Brush="White">
                                                                        <GeometryDrawing.Geometry>
                                                                            <RectangleGeometry Rect="0,0,8,8"/>
                                                                        </GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                    <GeometryDrawing Brush="#BDBDBD">
                                                                        <GeometryDrawing.Geometry>
                                                                            <GeometryGroup>
                                                                                <RectangleGeometry Rect="0,0,4,4"/>
                                                                                <RectangleGeometry Rect="4,4,4,4"/>
                                                                            </GeometryGroup>
                                                                        </GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                </DrawingGroup>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <!-- 透明→純色 漸層（Fill 由 C# 動態建立） -->
                                                <Rectangle x:Name="PART_AlphaGradientRect"/>
                                            </Grid>
                                        </Border>
                                        <!-- 互動 Slider（透明軌道，疊在漸層之上） -->
                                        <Slider x:Name="PART_AlphaSlider" IsMoveToPointEnabled="True"
                                                Minimum="0" Maximum="255"
                                                OverridesDefaultStyle="True"
                                                Template="{StaticResource ColorPicker.AlphaSliderTemplate}"/>
                                    </Grid>

                                    <!-- 模式切換按鈕 -->
                                    <Button x:Name="PART_ModeButton"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Stretch"
                                            Padding="4,4"
                                            FontSize="10"
                                            Content="HEX"/>

                                    <!-- HEX 模式：R / G / B 個別拉桿 + 輸入框 -->
                                    <StackPanel x:Name="PART_HexSliders" Margin="0,6,0,0" Visibility="Visible">
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="R" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_HexRSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_HexRTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="G" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_HexGSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_HexGTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48">
                                            <TextBlock Text="B" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_HexBSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_HexBTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ARGB 模式：A / R / G / B 個別拉桿 + 輸入框 -->
                                    <StackPanel x:Name="PART_ArgbRow" Margin="0,6,0,0" Visibility="Collapsed">
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="A" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_ASlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_ATextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="R" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_RSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_RTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="G" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_GSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_GTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48">
                                            <TextBlock Text="B" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_BSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="255" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_BTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- HSL 模式：H / S / L 個別拉桿 + 輸入框 -->
                                    <StackPanel x:Name="PART_HslRow" Margin="0,6,0,0" Visibility="Collapsed">
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="H" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_HSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="360" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_HTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48" Margin="0,0,0,3">
                                            <TextBlock Text="S" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_SSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="100" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_SHTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="14,4,*,4,48">
                                            <TextBlock Text="L" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextControlForeground}"/>
                                            <Slider x:Name="PART_LSlider" IsMoveToPointEnabled="True" Grid.Column="2" Minimum="0" Maximum="100" OverridesDefaultStyle="True" Template="{StaticResource ColorPicker.ChannelSliderTemplate}"/>
                                            <TextBox x:Name="PART_LTextBox" Grid.Column="4" Padding="4,5" FontSize="11" MaxLength="3" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 預覽色塊 + HEX 輸入框（所有模式常駐顯示） -->
                                    <Grid ColumnDefinitions="40,8,*" Margin="0,8,0,0">
                                        <Border Grid.Column="0"
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource ExpanderHeaderBorderBrush}"
                                                BorderThickness="1"
                                                Height="40"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Rectangle>
                                                    <Rectangle.Fill>
                                                        <DrawingBrush TileMode="Tile"
                                                                      Viewport="0,0,8,8"
                                                                      ViewportUnits="Absolute">
                                                            <DrawingBrush.Drawing>
                                                                <DrawingGroup>
                                                                    <GeometryDrawing Brush="White">
                                                                        <GeometryDrawing.Geometry>
                                                                            <RectangleGeometry Rect="0,0,8,8"/>
                                                                        </GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                    <GeometryDrawing Brush="#BDBDBD">
                                                                        <GeometryDrawing.Geometry>
                                                                            <GeometryGroup>
                                                                                <RectangleGeometry Rect="0,0,4,4"/>
                                                                                <RectangleGeometry Rect="4,4,4,4"/>
                                                                            </GeometryGroup>
                                                                        </GeometryDrawing.Geometry>
                                                                    </GeometryDrawing>
                                                                </DrawingGroup>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle x:Name="PART_PreviewRect"/>
                                            </Grid>
                                        </Border>
                                        <TextBox x:Name="PART_HexTextBox"
                                                 Grid.Column="2"
                                                 Padding="6,5"
                                                 FontSize="11"
                                                 MaxLength="9"
                                                 VerticalContentAlignment="Center"
                                                 Text="#FF0000"/>
                                    </Grid>

                                </StackPanel>
                            </Border>
                        </Popup>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 設為預設套用 -->
    <Style TargetType="{x:Type el:ColorPicker}"
           BasedOn="{StaticResource DefaultColorPickerStyle}"/>

</ResourceDictionary>
